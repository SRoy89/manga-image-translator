{
  "translator": {
    "translator": "openai",
    "no_text_lang_skip": true
  },
  "detector": {
    "detector": "default",
    "detection_size": 2560,
    "text_threshold": 0.4,
    "box_threshold": 0.4,
    "det_rotate": false,
    "det_auto_rotate": false,
    "det_invert": false,
    "det_gamma_correct": false
  },
  "ocr": {
    "ocr": "48px_ctc",
    "text_scale": 32,
    "use_mocr_merge": false,
    "min_text_length": 0,
    "ignore_bubble": 0
  },
  "inpainter": {
    "inpainter": "lama_large",
    "inpainting_size": 2048,
    "inpainting_precision": "bf16"
  },
  "render": {
    "alignment": "center",
    "direction": "horizontal",
    "font_size_offset": -3,
    "font_size_minimum": 10
  }
}
